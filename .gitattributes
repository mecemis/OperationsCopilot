# Normalise line endings so a Windows checkout does not produce CRLF diffs, and so the
# shell-ish files that must stay LF (Dockerfile, .sh) are never converted.
* text=auto eol=lf

*.png binary
*.jpg binary
*.ico binary

# Generated by EF Core — collapse in diffs and exclude from language stats.
src/OperationsCopilot.Infrastructure/Persistence/Migrations/** linguist-generated=true
